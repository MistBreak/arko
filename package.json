{
  "name": "arko",
  "productName": "Arko",
  "version": "0.2.0",
  "description": "An AI-native, Chromium-based desktop browser inspired by Arc — featuring Spaces, a 3-tier vertical sidebar, Split View, and built-in agentic workflows.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "author": "MistBreak <https://github.com/MistBreak>",
  "homepage": "https://github.com/MistBreak/arko",
  "repository": {
    "type": "git",
    "url": "https://github.com/MistBreak/arko.git"
  },
  "bugs": {
    "url": "https://github.com/MistBreak/arko/issues"
  },
  "keywords": [
    "browser",
    "arc-alternative",
    "chromium",
    "electron",
    "ai-browser",
    "vertical-tabs",
    "spaces",
    "macos",
    "agentic"
  ],
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
